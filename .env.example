# ─── AI Provider Configuration ───────────────────────────────────────────────
#
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and will never be committed.
#
# ⚠ SECURITY NOTE: VITE_ variables are embedded in the client-side JavaScript
# bundle and are visible to anyone who inspects the page source or network
# traffic. This configuration is suitable for demos and local development only.
# For a production deployment, proxy all AI API calls through a backend server
# so the key is never exposed to end users.
#
# Supported providers (any OpenAI-compatible /v1/chat/completions endpoint):
#   - OpenAI:      https://api.openai.com
#   - IBM watsonx: https://us-south.ml.cloud.ibm.com/ml/v1-beta/generation/text
#                  (requires adapting the request format)
#   - Ollama:      http://localhost:11434
#   - Any other OpenAI-compatible endpoint
#
# If VITE_AI_API_KEY is left empty, the app uses the local keyword classifier.
# ─────────────────────────────────────────────────────────────────────────────

VITE_AI_API_KEY=
VITE_AI_BASE_URL=https://api.openai.com
VITE_AI_MODEL=gpt-4o-mini
